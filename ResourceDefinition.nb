Cell[TextData[{
 "The curves and (hyper-)surfaces found by ",
 ButtonBox["Quantile Regression (QR)",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Quantile_regression"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Quantile_regression"],
 " are called \"regression quantiles\"."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.891622235609129*^9, 3.891622260501296*^9}, {
  3.995811290011799*^9, 3.9958113090785313`*^9}, {3.9958889513856983`*^9, 
  3.995888951386115*^9}},
 CellTags->"DefaultContent",
 CellID->889292814,ExpressionUUID->"07544ea1-7df5-47c7-83a5-62b8fc825952"],

Cell["\<\
For two-dimensional data QR is done with a B-spline basis, a Chebyshev \
functions basis, or a custom function basis.\
\>", "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.891622261640975*^9, 3.891622348495248*^9}, {
  3.891623977143889*^9, 3.891623994979281*^9}, {3.995811337189232*^9, 
  3.99581139159544*^9}},
 CellID->208108451,ExpressionUUID->"25d80457-97b6-477a-8434-35c705e98c6f"],

Cell[TextData[{
 "For higher dimensional data QR is doen with a ",
 ButtonBox["Non-Uniform Rational B-Spline (NURBS)",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Non-uniform_rational_B-spline"], None},
  
  ButtonNote->"https://en.wikipedia.org/wiki/Non-uniform_rational_B-spline"],
 " basis or a custom function basis."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.995811393352044*^9, 3.995811402093553*^9}, {
  3.995811631790454*^9, 3.995811639441037*^9}, {3.995811670910582*^9, 
  3.995811729740191*^9}, {3.995811778085395*^9, 3.995811856002245*^9}},
 CellID->1118390852,ExpressionUUID->"09575706-c64e-4d66-b3df-6a1f22a692fd"],

Cell["QR is used to find \"contextual outliers\".", "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.891622360109433*^9, 3.891622382134314*^9}},
 CellID->1471036014,ExpressionUUID->"f37bda7b-ff69-45f0-b46d-cb63d276dd9a"],

Cell["\<\
Using the found regression quantiles a conditional distribution estimate can \
be found at each regressor point.\
\>", "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.891622386479597*^9, 3.89162242774105*^9}, {
  3.891624010711567*^9, 3.891624026691999*^9}},
 CellID->1473486971,ExpressionUUID->"f94de469-4722-4bcd-b7d8-a60e5ef3c1c0"],

Cell["\<\
The found regression quantiles can be used to generate random data that \
closely resembles the original data.\
\>", "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.891622433887778*^9, 3.891622460793339*^9}, {
  3.891623488138546*^9, 3.891623488655917*^9}, {3.995812004175638*^9, 
  3.995812074879168*^9}},
 CellID->840197388,ExpressionUUID->"4e500cd3-9edc-4c74-810f-ac6b89b36d3a"],

Cell["\<\
The software monad has functions for computing linear regession, neural nets \
regression, and QR.\
\>", "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.891623492935266*^9, 3.891623531473935*^9}, {
  3.891624055826191*^9, 3.891624063154578*^9}, {3.995811921682122*^9, 
  3.995811927081588*^9}},
 CellID->591253344,ExpressionUUID->"bb22095d-dc59-4530-9cbc-acf3331f2a6e"]
}, Open  ]],

