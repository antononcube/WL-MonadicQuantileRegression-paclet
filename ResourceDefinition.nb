Cell["\<\
A software monad implementation for Quantile Regression workflows. B-spline, \
Chebyshev, and custom function bases are supported.\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.891620803053677*^9, 3.8916208038949833`*^9}, {
  3.891622186215129*^9, 3.891622211526675*^9}, {3.891624805708962*^9, 
  3.891624841056028*^9}},
 CellTags->"DefaultContent",
 CellID->441612482,ExpressionUUID->"debb98de-732f-4ecd-b0ba-333e380eafb9"]
}, Open  ]],

