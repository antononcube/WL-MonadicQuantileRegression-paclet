Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1122", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"c", "=", "2"}], ",", 
      RowBox[{"h", "=", "0.1"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"data", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", "y", ",", 
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", 
                RowBox[{"(", 
                 RowBox[{
                  SuperscriptBox["x", "2"], "+", 
                  SuperscriptBox["y", "2"]}], ")"}]}], "/", "4"}], "]"}], "*", 
             RowBox[{"(", 
              RowBox[{"1", "+", 
               RowBox[{"RandomReal", "[", "1.2", "]"}]}], ")"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", 
            RowBox[{"-", "c"}], ",", "c", ",", "h"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"y", ",", "x", ",", "c", ",", "h"}], "}"}]}], "]"}], ",", 
        "1"}], "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"reg", "=", 
   RowBox[{"ConvexHullRegion", "[", 
    RowBox[{"Most", "/@", "data"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"qrObj", "=", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"QRMonUnit", "[", "data", "]"}], "\[DoubleLongRightArrow]", 
    "\[IndentingNewLine]", 
    RowBox[{"QRMonQuantileRegression", "[", 
     RowBox[{"6", ",", 
      RowBox[{"{", 
       RowBox[{"0.2", ",", "0.8"}], "}"}]}], "]"}], "\[DoubleLongRightArrow]",
     "\[IndentingNewLine]", 
    RowBox[{"QRMonPlot", "[", 
     RowBox[{
      RowBox[{"RegionFunction", "->", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "y"}], "}"}], ",", 
         RowBox[{"RegionMember", "[", 
          RowBox[{"reg", ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], "]"}]}], ",", 
      RowBox[{"PerformanceGoal", "->", "\"\<Quality\>\""}]}], "]"}]}]}], 
  ";"}]}], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.995965454404767*^9, 3.99596548501304*^9}, {
